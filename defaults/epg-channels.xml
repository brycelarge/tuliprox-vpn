<?xml version="1.0" encoding="UTF-8"?>
<!--
  EPG Scraper Channels Configuration
  ====================================
  This file controls which channels the built-in EPG scraper fetches data for.
  It is copied to /app/epg/channels.xml on first boot if none exists.

  To customise:
    1. Edit /app/epg/channels.xml (mapped to your host appdata/epg/ directory)
    2. Restart the container — a fresh grab will run automatically

  Channel ID format for dstv.com:
    site_id="<country_code>#<channel_number>"
    e.g. zaf#201 = SuperSport Grandstand (South Africa)

  Full ZA channel list:
    https://github.com/iptv-org/epg/blob/master/sites/dstv.com/dstv.com_za.channels.xml

  Other supported sites:
    https://github.com/iptv-org/epg/tree/master/sites

  Once the scraper runs, reference the output in source.yml:
    epg:
      sources:
        - url: http://127.0.0.1:3002/guide.xml
-->
