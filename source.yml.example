---
# tuliprox sources configuration
# Copy this to your config volume: ./data/config/source.yml
# Full documentation: https://github.com/euzu/tuliprox/wiki
# Can also be configured via the GUI node editor at Settings → Sources
#
# Valid top-level fields: templates, sources

templates:
  - name: ALL_CHANNELS
    value: Group ~ ".*"

sources:
  - inputs:
      - name: my-provider
        type: m3u             # or: xtream
        url: 'http://YOUR_PROVIDER/get.php?username=USER&password=PASS&type=m3u_plus&output=ts'
        epg_url: 'http://YOUR_PROVIDER/xmltv.php?username=USER&password=PASS'
    targets:
      - name: my_channels
        filter: "!ALL_CHANNELS!"
        output:
          - type: m3u
          - type: xtream
