---
# tuliprox sources and targets configuration
# Copy this to your config volume: ./data/config/source.yml
# Full documentation: https://github.com/euzu/tuliprox/wiki

# Define your IPTV playlist sources here
sources: []
# Example:
# sources:
#   - name: my-provider
#     url: http://my-iptv-provider.com/get.php?username=USER&password=PASS&type=m3u_plus&output=ts
#     epg_url: http://my-iptv-provider.com/xmltv.php?username=USER&password=PASS
#     targets:
#       - name: my-output
#         output:
#           - type: m3u
#             filename: playlist.m3u
#           - type: xmltv
#             filename: epg.xml

# templates: []  # optional reusable template definitions
