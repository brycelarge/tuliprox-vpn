#!/usr/bin/with-contenv bash
# shellcheck shell=bash
# Optional EPG scraper service — only runs if EPG_SCRAPER_ENABLED=true

set -uo pipefail

source /scripts/logging.sh

EPG_SCRAPER_ENABLED="${EPG_SCRAPER_ENABLED:-false}"

if [ "${EPG_SCRAPER_ENABLED}" != "true" ]; then
    log "[epg-scraper] disabled (set EPG_SCRAPER_ENABLED=true to enable)"
    exec sleep inf
fi

EPG_DIR="/app/epg"
SCRAPER_DIR="/app/epg-scraper"
CHANNELS_FILE="${EPG_DIR}/channels.xml"
OUTPUT_FILE="${EPG_DIR}/guide.xml"
GRAB_DAYS="${EPG_GRAB_DAYS:-3}"
GRAB_INTERVAL="${EPG_GRAB_INTERVAL:-86400}"
SERVE_PORT="${EPG_SERVE_PORT:-3002}"
REPO_URL="https://github.com/iptv-org/epg.git"

mkdir -p "${EPG_DIR}"
chown tuliprox:tuliprox "${EPG_DIR}"

# ── Install scraper on first run ──────────────────────────────────────────────
if [ ! -d "${SCRAPER_DIR}/node_modules" ]; then
    log "[epg-scraper] cloning iptv-org/epg..."
    rm -rf "${SCRAPER_DIR}"
    git clone --depth=1 "${REPO_URL}" "${SCRAPER_DIR}" 2>&1 | s6-log -b n5 s500000 "${EPG_DIR}"
    log "[epg-scraper] installing dependencies (this may take a minute)..."
    cd "${SCRAPER_DIR}"
    npm install --omit=dev 2>&1 | tail -3
    log "[epg-scraper] scraper ready"
fi

# ── Copy default channels file if none exists ─────────────────────────────────
if [ ! -f "${CHANNELS_FILE}" ]; then
    log "[epg-scraper] no channels.xml found — copying default DStv ZA channels"
    cp "${SCRAPER_DIR}/sites/dstv.com/dstv.com_za.channels.xml" "${CHANNELS_FILE}"
    chown tuliprox:tuliprox "${CHANNELS_FILE}"
    log "[epg-scraper] edit ${CHANNELS_FILE} to customise channels, then restart"
fi

# ── Grab function ─────────────────────────────────────────────────────────────
run_grab() {
    log "[epg-scraper] starting grab (days=${GRAB_DAYS}, channels=${CHANNELS_FILE})"
    cd "${SCRAPER_DIR}"
    s6-setuidgid tuliprox node node_modules/.bin/tsx scripts/commands/epg/grab.ts \
        --channels="${CHANNELS_FILE}" \
        --output="${OUTPUT_FILE}" \
        --days="${GRAB_DAYS}" 2>&1 || log "[epg-scraper] grab failed — will retry next interval"
    log "[epg-scraper] grab complete → ${OUTPUT_FILE}"
    chown tuliprox:tuliprox "${OUTPUT_FILE}" 2>/dev/null || true
}

# ── Run initial grab if no guide exists ──────────────────────────────────────
if [ ! -f "${OUTPUT_FILE}" ]; then
    run_grab
fi

# ── Background re-grab loop ───────────────────────────────────────────────────
(
    while true; do
        sleep "${GRAB_INTERVAL}"
        run_grab
    done
) &

# ── Serve guide.xml ───────────────────────────────────────────────────────────
log "[epg-scraper] serving ${EPG_DIR} on port ${SERVE_PORT}"
log "[epg-scraper] EPG URL: http://localhost:${SERVE_PORT}/guide.xml"
log "[epg-scraper] Add to source.yml: url: http://127.0.0.1:${SERVE_PORT}/guide.xml"

exec s6-setuidgid tuliprox \
    node "${SCRAPER_DIR}/node_modules/.bin/serve" \
    -l "${SERVE_PORT}" \
    "${EPG_DIR}"
