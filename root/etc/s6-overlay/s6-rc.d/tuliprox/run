#!/usr/bin/with-contenv bash
# shellcheck shell=bash

set -euo pipefail

# shellcheck source=/scripts/logging.sh
source /scripts/logging.sh

umask "${UMASK:-022}"

cd /app

args=( -s -p /app/config )

if [ -n "${TULIPROX_ARGS:-}" ]; then
    # Intentionally allow word splitting for user-supplied args
    # shellcheck disable=SC2206
    extra_args=( ${TULIPROX_ARGS} )
    args+=( "${extra_args[@]}" )
fi

log_dir="/app/config/logs/tuliprox"
mkdir -p "${log_dir}"
chown -R tuliprox:tuliprox "${log_dir}" 2>/dev/null || true

config_file="/app/config/config.yml"
if [ ! -f "${config_file}" ]; then
    log "[tuliprox] waiting for ${config_file} to exist before starting"
    while [ ! -f "${config_file}" ]; do
        sleep 5
    done
    log "[tuliprox] config found, starting"
fi

sleep 2

log "[tuliprox] starting"

# Note: piping to s6-log means this script remains PID 1 of the service (not the app).
exec s6-setuidgid tuliprox /app/tuliprox "${args[@]}" 2>&1 | s6-log -b n20 s1000000 "${log_dir}"
